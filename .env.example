# SMTP Configuration for Nodemailer (e.g. Gmail App Passwords)
# Get an App Password from Google Account Settings: https://myaccount.google.com/apppasswords
# See guide: https://support.google.com/accounts/answer/185833
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password-here

# Email where you want to RECEIVE the contact form messages
CONTACT_EMAIL=your-email@gmail.com
